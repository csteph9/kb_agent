TELEGRAM_BOT_TOKEN=<BOT TOKEN>
TELEGRAM_ALLOWED_USER_IDS=<USER_ID1>,<USER_ID2>
TELEGRAM_USER_NAMES=<USER_ID1>:<USERNAME1>,<USER_ID2>:<USERNAME2>
REMINDER_TIME=07:30
REMINDER_FILE=reminders.md
REMINDER_WEATHER_LOCATION=<City, State>
REMINDER_NEWS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://feeds.npr.org/1001/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml
GMAIL_ENABLED=false
GMAIL_STATE_DIR=/opt/knowledge-agent/gmail
GMAIL_QUERY=newer_than:14d -category:promotions -category:social
GMAIL_MAX_MESSAGES_PER_RUN=10
GMAIL_MAX_EMAIL_CHARS=20000
GMAIL_PROCESS_ATTACHMENTS=true
GMAIL_MAX_ATTACHMENTS_PER_MESSAGE=5
GMAIL_MAX_ATTACHMENT_CHARS=50000

# Modular ingestion: per-source settings live in config/sources/*.json.
# Legacy GMAIL_* values above are imported once by migrate-gmail.
# INGEST_SOURCE_DIR=/opt/knowledge-agent/config/sources
# INGEST_STATE_DIR=/opt/knowledge-agent/var/ingest
# INGEST_MODEL_TIMEOUT_SECONDS=900

# Shared Codex pacing across Telegram, classification, reminders and ingestion.
# CODEX_CONTROL_DIR=/opt/knowledge-agent/var/codex
# CODEX_MIN_GAP_SECONDS=1
# CODEX_MAX_ATTEMPTS=3
# CODEX_RETRY_BASE_SECONDS=30
# CODEX_RETRY_MAX_SECONDS=120
# CODEX_RETRY_JITTER_SECONDS=5
# CODEX_FAILURE_COOLDOWN_SECONDS=120
# CODEX_QUEUE_TIMEOUT_SECONDS=300
# CODEX_CALL_TIMEOUT_SECONDS=900
# CODEX_CLASSIFIER_TIMEOUT_SECONDS=120
